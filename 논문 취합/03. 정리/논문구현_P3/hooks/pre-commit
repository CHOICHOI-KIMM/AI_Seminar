#!/bin/sh
# 자립판 지속 갱신 2층 (계획: 작업결과 §자립판) — viewer 변경 커밋 시 자립판 자동 재생성.
# - viewer/ 미변경 커밋(Main bearing 등)은 즉시 통과 (무간섭)
# - main 워크트리(viewer 부재)에서도 안전: 빌더 없으면 통과
# - 우회(--no-verify) 시에도 3층(build_standalone.py --check)이 잡는다.
top=$(git rev-parse --show-toplevel) || exit 0
builder="$top/논문 취합/03. 정리/논문구현_P3/viewer/build_standalone.py"
[ -f "$builder" ] || exit 0
# viewer/ 소스가 스테이징됐는지 (자립판 산출물 자신은 제외 — 자기 트리거 방지)
changed=$(git diff --cached --name-only | grep "viewer/" | grep -v "micropitting_viewer.html")
[ -n "$changed" ] || exit 0

# ★ 항상 재빌드 + add: --check 통과(이미 최신)라도 그 최신본이 **미스테이징**일 수 있으므로
#   스킵하지 않는다(옛 결함: 디스크 최신·미커밋 자립판을 놓쳐 커밋에서 누락).
echo "[pre-commit] viewer 소스 변경 -> 자립판 재생성"
python "$builder" || { echo "[pre-commit] 자립판 빌드 실패 - 커밋 중단"; exit 1; }
git add "$top/논문 취합/03. 정리/논문구현_P3/viewer/micropitting_viewer.html"
echo "[pre-commit] micropitting_viewer.html 갱신본을 커밋에 포함"
